# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in.
#
# SETUP.md explains where every value comes from, step by step.
# COOLIFY.md covers putting this on a server.
#
# .env.local is ignored by git. Never commit your real keys.
# ---------------------------------------------------------------------------

# --- Gemini: the AI that writes the post -----------------------------------

# REQUIRED. Your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model does the writing. Just a name, so you can change it here without
# touching any code. The model dropdown at https://aistudio.google.com is the
# authoritative list for your own key.
GEMINI_MODEL=gemini-2.5-flash

# --- PocketBase: where your templates and your posts live -------------------

# The address of your PocketBase server.
# On your own computer: http://127.0.0.1:8090
# Inside Docker compose: http://pocketbase:8090
# On a server:           https://pb.yourdomain.com   (no slash on the end)
#
# Note there is no NEXT_PUBLIC_ prefix on this. Nothing in the browser talks to
# PocketBase — every database call happens on the server — so the address is
# never published to the browser bundle.
POCKETBASE_URL=http://127.0.0.1:8090

# The PocketBase superuser account. This is NOT a real email login: it is an
# account that only exists inside PocketBase, with a password you invented.
# If you already run the CV system, use the same account.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Optional: everything below has a sensible default ----------------------

# Which Chrome or Chromium renders the slides into a PDF or PNG.
# Leave blank and the app finds one itself — it checks Playwright's browsers,
# then the usual Google Chrome, Chromium and Edge locations on Mac, Windows and
# Linux. The Docker image sets this to /usr/bin/chromium already.
#
#   Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux:   /usr/bin/chromium
PDF_CHROMIUM_PATH=

# Largest .zip file the dashboard will accept, in megabytes.
MAX_UPLOAD_MB=50

# --- Optional: making new slide designs -------------------------------------

# The design studio at /templates/new writes a new slide design with Gemini,
# renders it to check it works, then saves it in two places: PocketBase, so it
# is in the picker straight away, and templates/ in the repository, so it is in
# git and survives the database.
#
# Without these two the studio still works — the design is saved to PocketBase
# and it says it was not committed.
#
# The token is a fine-grained personal access token from
# https://github.com/settings/personal-access-tokens with ONE permission:
# Contents: Read and write, on this repository only. Nothing else is used.
GITHUB_TOKEN=
GITHUB_REPO=level-one-ai/linkedin-carousel-engine

# Which branch the design is committed to.
GITHUB_BRANCH=claude/linkedin-carousel-generator-gg73ng

# --- Publishing -------------------------------------------------------------

# Where this app is reachable from the public internet, with NO trailing slash.
# For example https://media.levelone.digital
#
# Facebook and Instagram do not accept an upload: they fetch the picture from a
# URL, so this has to be an address their servers can reach. A link to localhost
# publishes nothing.
PUBLIC_BASE_URL=

# The accounts themselves are NOT here. Access tokens expire and get refreshed,
# and a value that changes at runtime does not belong in a file that needs a
# redeploy to change, so they live in the platform_connections collection in
# PocketBase. SETUP.md says where to get each one.

# The API versions. Both have sensible defaults; set them only when a network
# retires the one in use.
LINKEDIN_API_VERSION=
META_GRAPH_VERSION=

# Where the publishing calls go. Empty means the real APIs, which is what you
# want. They exist so the publishing path can be tested against a stub.
LINKEDIN_API_BASE=
META_GRAPH_BASE=

# Where the Gemini calls go. Empty means Google's own endpoint.
GEMINI_BASE_URL=
