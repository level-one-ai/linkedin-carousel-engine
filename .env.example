# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# See SETUP.md for step by step instructions on where each value comes from.
# ---------------------------------------------------------------------------

# REQUIRED. Your Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The Gemini model that writes the caption and the slides.
GEMINI_MODEL=gemini-2.5-flash

# Address of the Gotenberg container that turns HTML into PDF and PNG files.
# Inside Docker use http://gotenberg:3000
# Running "npm run dev" on your own machine, use http://127.0.0.1:3000
GOTENBERG_URL=http://127.0.0.1:3000

# Address of the PocketBase database.
# Inside Docker use http://pocketbase:8090
# Running "npm run dev" on your own machine, use http://127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090

# The PocketBase admin account you create in SETUP.md step 4.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Largest .zip file the dashboard will accept, in megabytes.
MAX_UPLOAD_MB=50
